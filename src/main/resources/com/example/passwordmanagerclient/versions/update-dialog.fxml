<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.passwordmanagerclient.controller.versions.UpdateDialogController"
      spacing="15" alignment="CENTER" prefWidth="380" style="-fx-padding: 20;">

    <Label text="Update Available"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label fx:id="versionLabel" wrapText="true"
           style="-fx-font-size: 14px;"/>

    <Label fx:id="descLabel" wrapText="true"
           style="-fx-font-size: 13px; -fx-text-fill: #444;"/>

    <Label fx:id="releaseLabel" wrapText="true"
           style="-fx-font-size: 13px; -fx-text-fill: #444;"/>

    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="downloadBtn" text="Download Update" prefWidth="140"/>
        <Button fx:id="exitBtn" text="Exit" prefWidth="80"/>
    </HBox>
</VBox>
