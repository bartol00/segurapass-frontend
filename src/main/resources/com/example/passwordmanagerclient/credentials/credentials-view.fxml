<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.passwordmanagerclient.controller.credentials.CredentialsController"
            prefWidth="800" prefHeight="600">

    <top>
        <Label text="Your Stored Credentials" style="-fx-font-size: 18px; -fx-padding: 10;" />
    </top>

    <center>
        <TableView fx:id="credentialsTable" prefWidth="800">
            <columns>
                <TableColumn fx:id="websiteColumn" text="Website" prefWidth="200"/>
                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="200"/>
                <TableColumn fx:id="passwordColumn" text="Password" prefWidth="200"/>
                <TableColumn fx:id="lastUpdatedColumn" text="Last Updated" prefWidth="180"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="6" style="-fx-padding: 10;">
            <HBox spacing="10">
                <Button text="Add New Credential" onAction="#onAddCredential" />
                <Region fx:id="spacer" HBox.hgrow="ALWAYS"/>
                <Label text="Page size:" />
                <ComboBox fx:id="pageSizeCombo" prefWidth="80"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <Button text="« Prev" fx:id="prevButton" onAction="#onPrevPage"/>
                <Label fx:id="pageLabel" text="Page 1" />
                <Button text="Next »" fx:id="nextButton" onAction="#onNextPage"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>

