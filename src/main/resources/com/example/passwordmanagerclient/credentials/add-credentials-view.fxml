<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.passwordmanagerclient.controller.credentials.AddCredentialController"
      prefWidth="400" prefHeight="250"
      spacing="10" style="-fx-padding: 20;">
    <Label text="Add New Credentials" style="-fx-font-size: 16;" />

    <TextField fx:id="websiteField" promptText="Website" />
    <TextField fx:id="usernameField" promptText="Username" />
    <PasswordField fx:id="passwordField" promptText="Password" />

    <HBox spacing="10">
        <Button text="Save" fx:id="saveButton" onAction="#onSaveClick" />
        <Button text="Cancel" onAction="#onCancelClick" />
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: red;" />
</VBox>
