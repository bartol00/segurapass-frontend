<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.passwordmanagerclient.controller.credentials.DeleteConfirmationController"
            prefWidth="300" prefHeight="150"
            style="-fx-padding: 15; -fx-background-color: white;">

    <center>
        <Label text="Are you sure you want to delete this credential?"
               wrapText="true"
               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
            <Button fx:id="yesButton" text="Delete"
                    style="-fx-background-color: #f44336; -fx-text-fill: white;"
                    onAction="#onYesDelete"/>
            <Button fx:id="noButton" text="Cancel"
                    style="-fx-background-color: gray; -fx-text-fill: white;"
                    onAction="#onNo"/>
        </HBox>
    </bottom>
</BorderPane>

