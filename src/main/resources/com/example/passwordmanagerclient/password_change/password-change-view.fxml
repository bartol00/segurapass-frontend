<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.passwordmanagerclient.controller.password_change.PasswordChangeController"
      prefWidth="550" prefHeight="550"
      style="-fx-padding: 15; -fx-background-color: white;">

    <Label text="Old password:"
           wrapText="true"
           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <PasswordField fx:id="oldPassword" promptText="Old Password" />

    <Label text="New password:"
           wrapText="true"
           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <PasswordField fx:id="newPassword" promptText="New Password" />

    <Label text="Repeat new password:"
           wrapText="true"
           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <PasswordField fx:id="repeatNewPassword" promptText="Repeat New Password" />

    <VBox spacing="5" maxWidth="250" alignment="CENTER_LEFT">
        <ProgressBar fx:id="strengthBar" prefWidth="250" progress="0.0"/>
        <Label fx:id="strengthLabel" text="Password strength: " style="-fx-font-size: 11px;"/>
    </VBox>

    <VBox spacing="4" maxWidth="250" alignment="CENTER_LEFT" style="-fx-font-size: 12px;">
        <Label fx:id="lengthReq" text="• At least 14 characters" textFill="gray"/>
        <Label fx:id="lowercaseReq" text="• At least one lowercase letter" textFill="gray"/>
        <Label fx:id="uppercaseReq" text="• At least one uppercase letter" textFill="gray"/>
        <Label fx:id="numberReq" text="• At least one number" textFill="gray"/>
        <Label fx:id="specialReq" text="• At least one special character (@$!%*?...)" textFill="gray"/>
        <Label fx:id="passwordMatchReq" text="• Passwords match" textFill="gray"/>
    </VBox>

    <Label fx:id="statusLabel"/>

    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
        <Button fx:id="passwordChangeButton" text="Change Password"
                style="-fx-background-color: red; -fx-text-fill: white;"
                onAction="#onChange"/>
        <Button fx:id="cancelButton" text="Cancel"
                style="-fx-background-color: gray; -fx-text-fill: white;"
                onAction="#onCancel"/>
    </HBox>
</VBox>
