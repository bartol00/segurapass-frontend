<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.passwordmanagerclient.controller.authorization.RegisterController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: #f5f5f5;"
      prefWidth="700" prefHeight="600">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Register" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TextField fx:id="emailField" promptText="Email" maxWidth="300"/>
    <PasswordField fx:id="masterPasswordField" promptText="Master Password" maxWidth="300"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Master Password" maxWidth="300"/>

    <VBox spacing="5" maxWidth="300" alignment="CENTER_LEFT">
        <Label fx:id="strengthLabel" text="Password strength: " style="-fx-font-size: 11px;"/>
        <ProgressBar fx:id="strengthBar" prefWidth="300" progress="0.0"/>
    </VBox>

    <VBox spacing="4" maxWidth="300" alignment="CENTER_LEFT" style="-fx-font-size: 12px;">
        <Label fx:id="lengthReq" text="• At least 14 characters" textFill="gray"/>
        <Label fx:id="lowercaseReq" text="• At least one lowercase letter" textFill="gray"/>
        <Label fx:id="uppercaseReq" text="• At least one uppercase letter" textFill="gray"/>
        <Label fx:id="numberReq" text="• At least one number" textFill="gray"/>
        <Label fx:id="specialReq" text="• At least one special character (@$!%*?...)" textFill="gray"/>
        <Label fx:id="passwordMatchReq" text="• Passwords match" textFill="gray"/>
    </VBox>

    <Button text="Register" fx:id="registerButton"
            onAction="#onRegisterClick"
            maxWidth="120" disable="true"/>
    <Button text="Switch to Login" fx:id="switchLoginButton"
            onAction="#onSwitchToLogin"
            style="-fx-font-size: 11px;"/>
    <Button text="Remotely Delete Account" fx:id="remoteDeleteButton"
            onAction="#onOpenRemoteDelete"
            style="-fx-background-color: red; -fx-font-size: 11px;"/>
    <Button text="Change Server" fx:id="serverButton"
            style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold;"
            onAction="#onServerChange"/>

    <Label fx:id="statusLabel"/>

    <VBox alignment="CENTER" spacing="2">
        <Label text="Current Server URL: " fx:id="serverLabel"/>
        <Label text="Current App Version: " fx:id="versionLabel"/>
        <Label text="This app has been built with modern security practices in mind, but has not yet been independently audited."
               styleClass="security-notice"/>
        <Label text="Use at your own discretion."
               styleClass="security-notice"/>
    </VBox>
</VBox>
